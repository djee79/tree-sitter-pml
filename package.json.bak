{
  "name": "tree-sitter-aveva-pml-parser",
  "version": "0.1.0",
  "description": "Parser for the AVEVA Programmable macro language (PML)",
  "repository": "https://github.com/tree-sitter/tree-sitter-aveva_pml_parser",
  "license": "MIT",
  "tree-sitter": {
    "scope": "source.aveva_pml_parser",
    "file-types": ["pml", "pmlfnc", "pmlobj", "pmlfrm"],
    "highlights": "queries/highlights.scm",
    "injections": "queries/injections.scm"
  },

  "parser-directories": [
    "/mnt/nas/MainPool/Programmation/TreeSitter/tree-sitter-pml"
  ],

  "author": {
    "name": "Jean-Francois Nantel",
    "email": "jnantelf@gmail.com"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "aveva_pml_parser"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.22.4",
    "tree-sitter-cli": "^0.25.10"
  },
  "peerDependencies": {
    "tree-sitter": "^0.22.4"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
