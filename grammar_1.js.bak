
/**
 * @file Parser for the AVEVA Programmable macro language (PML)
 */

/// <reference types="tree-sitter-cli/dsl" />
// @ts-check

module.exports = grammar({
  name: "pml",

  extras: $ => [
    /[ \t]/,     // whitespace
    /\r?\n/,     // NEW: newline as whitespace
    /--.*/,      // comments
  ],

  rules: {
    source_file: $ => repeat(choice(
      $._definition,
      $._statement
    )),

    keyword_define:      _ => token(prec(2, /define/i)),
    keyword_function:    _ => token(prec(2, /function/i)),
    keyword_method:      _ => token(prec(2, /method/i)),
    keyword_endmethod:   _ => token(prec(2, /endmethod/i)),
    keyword_is:          _ => token(prec(2, /is/i)),
    keyword_return:      _ => token(prec(2, /return/i)),
    keyword_member:      _ => token(prec(2, /member/i)),
    keyword_object:      _ => token(prec(2, /object/i)),
    keyword_endobject:   _ => token(prec(2, /endobject/i)),
    keyword_endfunction: _ => token(prec(2, /endfunction/i)),
    keyword_handle:      _ => token(prec(2, /handle/i)),
    keyword_any:         _ => token(prec(2, /any/i)),
    keyword_endhandle:   _ => token(prec(2, /endhandle/i)),
    keyword_do:          _ => token(prec(2, /DO/i)),
    keyword_from:        _ => token(prec(2, /FROM/i)),
    keyword_to:          _ => token(prec(2, /TO/i)),
    keyword_by:          _ => token(prec(2, /BY/i)),
    keyword_enddo:       _ => token(prec(2, /ENDDO/i)),

    _definition: $ => choice(
      $.function_definition,
      $.object_definition,
      $.method_definition
    ),
//============== Function definition ==================
    function_definition: $ => seq(
      $.keyword_define,
      $.keyword_function,
      $.macro_function,
      $.argument_list,
      $.keyword_is,
      $.identifier,
      repeat($._statement),
      $.keyword_endfunction
    ),
//============== Object definition ==================
    object_definition: $ => seq(
      $.keyword_define,
      $.keyword_object,
      $.identifier,           // "ELEMENT"
      repeat($.member_definition),
      $.keyword_endobject
    ),
//============== Method definition ==================
    method_definition: $ => seq(
      $.keyword_define,
      $.keyword_method,
      $.method_identifier,
      $.argument_list,
      optional(seq($.keyword_is, $.type_identifier)),  // <- make type optional
      repeat($._statement),
      $.keyword_endmethod
    ),
//=============== end definition ====================
    member_definition: $ => seq(
      $.keyword_member,
      $.member_name,          // ".Type"
      $.keyword_is,
      $.type_identifier       // STRING, REAL, etc.
    ),

    method_call: $ => prec.left(7, seq(
      $.expression,
      '.',
      $.identifier,
      $.argument_list
    )),

    method_identifier: _ =>
      token(seq('.', /[A-Za-z_][A-Za-z0-9_]*/)),

    member_name: _ =>
      token(seq('.', /[A-Za-z_][A-Za-z0-9_]*/)),



      argument_list: $ => seq(
        '(',
       optional(commaSep($.expression)),
      ')'
    ),

    // EX: !Length is REAL
    parameter: $ => seq(
      $.variable,
      $.keyword_is,
      $.type_identifier
    ),

    builtin_type: _ =>
      /[A-Za-z_][A-Za-z0-9_]*/,

    _statement: $ => choice(
      $.assignment,
      $.return_statement,
      $.handle_statement,
      $.do_loop,
      $.expression_statement,
      $.pml1_command,
      $.bare_pml1_command
    ),






    do_loop: $ => seq(
      token(/DO/i),
      $.variable,
      token(/FROM/i),
      $.expression,
      token(/TO/i),
      $.expression,
      optional(seq(token(/BY/i), $.expression)),
      repeat($._statement),
      token(/ENDDO/i)
    ),


    handle_statement: $ => seq(
      $.keyword_handle,
      choice(
        seq('(', commaSep($.expression), ')'),   // handle (2,751)
        $.keyword_any                            // handle ANY
      ),
      repeat($._statement),
      $.keyword_endhandle
    ),

    assignment: $ => seq(
      choice($.variable, $.index_access),
      '=',
      $.expression
    ),

    return_statement: $ => seq(
      $.keyword_return,
      $.expression
    ),

    expression: $ => choice(
      $.method_call,
      $.function_call,
      $.index_access,
      $.member_access,   // keep after method_call
      $.variable,
      $.number,
      $.string_literal,
      $.parenthesized_expression,
      $.binary_expression
    ),


    function_call: $ => choice(
      seq($.macro_function, $.argument_list),  // !!Area(...)
      seq($.identifier, $.argument_list)       // file(), NAME(), etc.
    ),

    expression_statement: $ => $.expression,


    binary_expression: $ => prec.left(5, seq(
      $.expression,
      choice('+', '-', '*', '/', '&'),
      $.expression
    )),

    number: _ => /-?[0-9]+(\.[0-9]+)?/,

    // EX: !Length, !Width
    variable: _ => token(choice(
      seq('!!', /[A-Za-z_][A-Za-z0-9_]*/),  // system vars
      seq('!', /[A-Za-z_][A-Za-z0-9_]*/)    // normal vars
    )),

    macro_function: $ => token(prec(0, seq('!!', /[A-Za-z_][A-Za-z0-9_]*/))),


    identifier: _ => token(prec(-1, /[A-Za-z_][A-Za-z0-9_]*/)),



    index_access: $ => prec.left(7, seq(
      $.variable,
      repeat1(seq('[', $.expression, ']'))
    )),

    member_access: $ => prec.left(6, seq(
      $.expression,
      '.',
      $.identifier
    )),

    string_literal: _ => token(choice(
      // ASCII quoted strings with doubled '' escape
      seq("'", repeat(choice(/[^']/, "''")), "'"),

      // Unicode quote variant: ‘ … ’
      seq("‘", repeat(choice(/[^’]/, "’’")), "’"),

      // Pipe strings: | … |
      seq("|", repeat(choice(/[^|]/, "\\|")), "|")   
    )),


    parenthesized_expression: $ => seq(
      '(',
      $.expression,
      ')'
    ),

    boolean_literal: _ => token(choice('TRUE', 'FALSE')),

    type_identifier: _ =>
      token(choice('REAL', 'STRING', 'BOOLEAN', 'ARRAY')),

    pml1_command: _ => token(
      seq(
        '$',
        /[A-Za-z]/,
        /[^\r\n]*/   // consume EVERYTHING until newline
      )
    ),

    bare_pml1_command: $ =>
      prec.left("bare_pml1",
        seq(
          alias(token(/[A-Za-z][A-Za-z0-9_]*/), $.bare_cmd_identifier),
          repeat(choice(
            $.variable,
            $.string_literal,
            $.member_access,
            $.index_access,
            $.number
          ))
        )
      ),








    line_break: _ => /\r?\n/,




  },// End of Rules

  precedences: () => [
      ["bare_pml1"],
    ],

    conflicts: $ => [
      [$.bare_pml1_command, $.expression],
      [$.bare_pml1_command, $.function_call],
    ],


});

// Utility
function commaSep(rule) {
  return seq(rule, repeat(seq(',', rule)));
}
