{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "pml",
      "camelcase": "Pml",
      "title": "PML",
      "scope": "source.pml",
      "file-types": [
        "pml",
        "pmlfnc",
        "pmlobj",
        "pmlfrm",
        "pmlmac",
        "pmlcmd",
        "mac"
      ],
      "injection-regex": "^pml2?$",
      "class-name": "TreeSitterPml",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter parser for AVEVA PML2 (Programmable Macro Language)",
    "authors": [
      {
        "name": "Jean-Francois Nantel",
        "email": "jnantelf@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/djee79/tree-sitter-pml"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
