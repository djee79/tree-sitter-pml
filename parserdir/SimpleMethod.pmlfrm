define method .fill()
    !n = 0
    do !temp from !this.mini.val to !this.maxi.val by !this.step.val
        !n = !n + 1
        !temps[!n][1] = !n.string()
        !temps[!n][2] = !temp.string()
        !temps[!n][3] = |=|
        !fahren = !temp * 1.8 + 32
        !temps[!n][4] = STRING(!fahren,!!RealFMT)
    enddo
    !this.table1.setRows( !temps )
endmethod
